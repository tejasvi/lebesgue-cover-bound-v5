/-!
# The vertex table (core Lean)
-/

namespace LebesgueCover.Fast

/-- Vertex table: numerators over `2^40` of `V_{n,l}` (n = 3, 5, 7, 9). -/
def VT40 : Nat → Nat → Int × Int := fun n l => match n, l with
  | 3, 0 => (634803334274, 0)
  | 3, 1 => (-317401667137, 549755813888)
  | 3, 2 => (-317401667137, -549755813888)
  | 5, 0 => (578047470859, 0)
  | 5, 1 => (178626492051, 549755813888)
  | 5, 2 => (-467650227480, 339767778496)
  | 5, 3 => (-467650227480, -339767778496)
  | 5, 4 => (178626492051, -549755813888)
  | 7, 0 => (563893808987, 0)
  | 7, 1 => (351582039235, 440869932635)
  | 7, 2 => (-125478177028, 549755813888)
  | 7, 3 => (-508050766700, 244664354309)
  | 7, 4 => (-508050766700, -244664354309)
  | 7, 5 => (-125478177028, -549755813888)
  | 7, 6 => (351582039235, -440869932635)
  | 9, 0 => (558236683461, 0)
  | 9, 1 => (427634109310, 358827623401)
  | 9, 2 => (96936782790, 549755813888)
  | 9, 3 => (-279118341730, 483447149201)
  | 9, 4 => (-524570892100, 190928190487)
  | 9, 5 => (-524570892100, -190928190487)
  | 9, 6 => (-279118341730, -483447149201)
  | 9, 7 => (96936782790, -549755813888)
  | 9, 8 => (427634109310, -358827623401)
  | _, _ => (0, 0)

/-- The vertex table as rationals. -/
def VQ (n l : Nat) : Rat × Rat := (mkRat (VT40 n l).1 (2 ^ 40), mkRat (VT40 n l).2 (2 ^ 40))

end LebesgueCover.Fast
